# Token Narrative Tracker Environment Variables

# Social media API keys (optional, free tiers available)
TWITTER_BEARER_TOKEN=your_twitter_bearer_token
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret

# RSS feed sources
RSS_FEEDS="https://rss.example.com/feed1,https://rss.example.com/feed2"

# Optional: Pushshift API for Reddit historical data
PUSHSHIFT_API_KEY=your_pushshift_api_key

# Run parameters
MAX_POSTS_PER_SOURCE=100
LOOKBACK_HOURS=72
MIN_MOMENTUM=0.3